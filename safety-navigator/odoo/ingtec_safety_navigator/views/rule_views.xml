<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rule_list" model="ir.ui.view">
        <field name="name">ingtec.rule.list</field>
        <field name="model">ingtec.rule</field>
        <field name="arch" type="xml">
            <list string="Regelwerk" decoration-success="state == 'approved'"
                  decoration-muted="state in ('withdrawn', 'archived')"
                  decoration-warning="state == 'review'">
                <field name="priority" widget="badge"/>
                <field name="code"/>
                <field name="title"/>
                <field name="system_type_id"/>
                <field name="scope"/>
                <field name="assertion_quality"/>
                <field name="version"/>
                <field name="valid_from"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_rule_form" model="ir.ui.view">
        <field name="name">ingtec.rule.form</field>
        <field name="model">ingtec.rule</field>
        <field name="arch" type="xml">
            <form string="Regel">
                <header>
                    <button name="action_submit_review" type="object" string="Zur fachlichen Prüfung"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_reviewed" type="object" string="Fachlich geprüft"
                            invisible="state != 'review'"
                            groups="ingtec_safety_navigator.group_navigator_manager"/>
                    <button name="action_approve" type="object" string="Freigeben" class="btn-primary"
                            invisible="state not in ('draft', 'review')"
                            groups="ingtec_safety_navigator.group_navigator_manager"/>
                    <button name="action_withdraw" type="object" string="Zurückziehen"
                            invisible="state != 'approved'"
                            groups="ingtec_safety_navigator.group_navigator_manager"/>
                    <button name="action_reset_draft" type="object" string="Auf Entwurf zurücksetzen"
                            invisible="state in ('draft', 'archived')"
                            groups="ingtec_safety_navigator.group_navigator_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="state == 'approved'">
                        Diese Regel ist nicht freigegeben. Sie erzeugt keine Ergebnisse für externe Nutzer.
                    </div>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="Kraftbetriebenes Tor – wiederkehrende Prüfung"/></h1>
                        <h3><field name="code" placeholder="RULE-AMVO-GATE-001"/></h3>
                    </div>
                    <group>
                        <group string="Geltung">
                            <field name="system_type_id"
                                   placeholder="Leer lassen für übergreifende Regeln"/>
                            <field name="scope"/>
                            <field name="version"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="active"/>
                        </group>
                        <group string="Bindungswirkung">
                            <field name="assertion_quality"/>
                            <field name="priority"/>
                            <field name="legal_basis"/>
                            <field name="source_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bedingungen" name="conditions">
                            <p class="text-muted">
                                Bedingungsbaum aus <code>all</code>, <code>any</code>, <code>not</code> und
                                Blattbedingungen <code>{"fact": "...", "op": "...", "value": ...}</code>.
                                Fehlt ein Fakt, liefert die Rule Engine "unbestimmt" und der Navigator
                                stellt die zugehörige Frage.
                            </p>
                            <field name="conditions" widget="json"/>
                        </page>
                        <page string="Ergebnis" name="outcome">
                            <group>
                                <field name="outcome_kind"/>
                                <field name="outcome_statement"/>
                                <label for="outcome_interval_value"/>
                                <div class="o_row">
                                    <field name="outcome_interval_value"/>
                                    <field name="outcome_interval_unit"/>
                                </div>
                                <field name="outcome_documents"/>
                                <field name="recommended_action"/>
                            </group>
                        </page>
                        <page string="Freigabe" name="release">
                            <group>
                                <field name="reviewed_by"/>
                                <field name="reviewed_on"/>
                                <field name="approved_by"/>
                                <field name="approved_on"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rule_search" model="ir.ui.view">
        <field name="name">ingtec.rule.search</field>
        <field name="model">ingtec.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="title"/>
                <field name="system_type_id"/>
                <filter name="draft" string="Entwurf" domain="[('state', '=', 'draft')]"/>
                <filter name="review" string="In Prüfung" domain="[('state', '=', 'review')]"/>
                <filter name="approved" string="Freigegeben" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="authority" string="Behördlich (Priorität 1)" domain="[('priority', '=', '1')]"/>
                <group expand="0" string="Gruppieren nach">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_priority" string="Priorität" context="{'group_by': 'priority'}"/>
                    <filter name="group_system" string="Anlagenart" context="{'group_by': 'system_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rule" model="ir.actions.act_window">
        <field name="name">Regelwerk</field>
        <field name="res_model">ingtec.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_rule_review" model="ir.actions.act_window">
        <field name="name">Freigabe offen</field>
        <field name="res_model">ingtec.rule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('draft', 'review'))]</field>
    </record>

</odoo>
