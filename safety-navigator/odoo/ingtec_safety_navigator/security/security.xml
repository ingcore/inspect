<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_safety_navigator" model="ir.module.category">
            <field name="name">INGTEC Safety Navigator</field>
            <field name="description">Rollen für Anlagenbibliothek, Regelwerk und Navigator-Vorgänge.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_navigator_user" model="res.groups">
            <field name="name">Navigator: Benutzer</field>
            <field name="category_id" ref="module_category_safety_navigator"/>
            <field name="comment">Darf Vorgänge sehen und bearbeiten, aber das Regelwerk nicht ändern.</field>
        </record>

        <record id="group_navigator_editor" model="res.groups">
            <field name="name">Navigator: Fachredaktion</field>
            <field name="category_id" ref="module_category_safety_navigator"/>
            <field name="implied_ids" eval="[(4, ref('group_navigator_user'))]"/>
            <field name="comment">Pflegt Anlagenbibliothek und Regelwerk. Freigabe bleibt der Leitung vorbehalten.</field>
        </record>

        <record id="group_navigator_manager" model="res.groups">
            <field name="name">Navigator: Fachliche Leitung</field>
            <field name="category_id" ref="module_category_safety_navigator"/>
            <field name="implied_ids" eval="[(4, ref('group_navigator_editor'))]"/>
            <field name="comment">Gibt Regeln fachlich frei (Abschnitt 24) und verwaltet Stammdaten.</field>
        </record>

        <!--
            Abschnitt 24: nur freigegebene Regeln dürfen Ergebnisse für
            externe Nutzer erzeugen. Die Regel wirkt zusätzlich zur
            Filterung in der API, damit ein einzelner Fehler in der API
            nicht sofort zu einer Ausgabe unfreigegebener Inhalte führt.
        -->
        <record id="rule_ingtec_rule_public_approved_only" model="ir.rule">
            <field name="name">Regelwerk: öffentlich nur freigegebene Regeln</field>
            <field name="model_id" ref="model_ingtec_rule"/>
            <field name="domain_force">[('state', '=', 'approved')]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
