            <field name="seo_description">Welche technischen Anlagen muss ein Industriebetrieb prüfen lassen? Der Safety Navigator zeigt Prüfbedarf, Fristen und Rechtsgrundlagen.</field>
            <field name="default_facts" eval="{'workplace': True, 'production': True}"/>
